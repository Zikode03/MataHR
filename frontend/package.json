{
  "name": "matahr-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:operations": "node --test tests/operations.test.cjs",
    "test:intelligence": "node --test tests/intelligence.test.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:administration": "node --test tests/administration.test.cjs",
    "test:corehr": "node --test tests/corehr.test.cjs",
    "test:policies": "node --test tests/policies.test.cjs",
    "test:startup": "node --experimental-vm-modules scripts/verify-dev-startup.cjs",
    "test:organisation": "node --test tests/organisation.test.cjs",
    "test:organisation-drag": "node --test tests/organisation-drag.test.cjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.0",
    "@vitejs/plugin-react": "^4.5.0"
  }
}
